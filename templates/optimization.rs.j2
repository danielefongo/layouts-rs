use std::fmt::Write as _;

fn scalar_std_dev(stats_list: &[f64], mean: f64) -> f64 {
    (stats_list
        .iter()
        .map(|v| (v - mean) * (v - mean))
        .sum::<f64>()
        / (stats_list.len() as f64))
        .sqrt()
}

fn map_std_dev<K>(
    stats_list: &[&IndexMap<K, f64>],
    mean_map: &IndexMap<K, f64>,
) -> IndexMap<K, f64>
where
    K: Eq + std::hash::Hash + Clone,
{
    mean_map
        .iter()
        .map(|(k, mean)| {
            let variance = stats_list
                .iter()
                .map(|m| {
                    let v = m.get(k).unwrap_or(&0.0);
                    (v - mean) * (v - mean)
                })
                .sum::<f64>()
                / (stats_list.len() as f64);
            (k.clone(), variance.sqrt())
        })
        .collect()
}

#[allow(dead_code)]
fn map_scale<K>(values: &IndexMap<K, f64>) -> f64 {
    values
        .values()
        .copied()
        .fold(0.0, f64::max)
        .max(1e-6)
}

fn mean_f64(values: &[f64]) -> f64 {
    if values.is_empty() {
        return 0.0;
    }
    values.iter().sum::<f64>() / values.len() as f64
}

fn round(v: f64, digits: usize) -> f64 {
    let factor = 10f64.powi(digits as i32);
    (v * factor).round() / factor
}

fn round_scale(v: f64, digits: usize) -> f64 {
    let min = 10f64.powi(-(digits as i32));
    round(v.max(min), digits)
}

fn mean_map<K>(maps: &[&IndexMap<K, f64>]) -> IndexMap<K, f64>
where
    K: Eq + std::hash::Hash + Clone,
{
    if maps.is_empty() {
        return IndexMap::new();
    }

    let mut result: IndexMap<K, f64> = IndexMap::new();
    for map in maps {
        for (k, v) in *map {
            *result.entry(k.clone()).or_default() += v;
        }
    }

    result.iter_mut().for_each(|(_, v)| *v /= maps.len() as f64);
    result
}

impl Stats {
    pub fn mean_and_std_dev(stats_list: &[Stats]) -> (Stats, Stats) {
        let mean = Stats {
            {%- for section in stats.sections %}
            {{ section.name }}: {{ section.name | capitalize }}Stats {
                {%- for stat in section.stats %}
                {%- match stat.ty %}
                {%- when dsl::Ty::Scalar %}
                {{ stat.name }}: mean_f64(&stats_list.iter().map(|s| s.{{ section.name }}.{{ stat.name }}).collect::<Vec<_>>()),
                {%- when dsl::Ty::Map(_) %}
                {{ stat.name }}: mean_map(&stats_list.iter().map(|s| &s.{{ section.name }}.{{ stat.name }}).collect::<Vec<_>>()),
                {%- endmatch %}
                {%- endfor %}
            },
            {%- endfor %}
        };

        let std_dev = Stats {
            {%- for section in stats.sections %}
            {{ section.name }}: {{ section.name | capitalize }}Stats {
                {%- for stat in section.stats %}
                {%- match stat.ty %}
                {%- when dsl::Ty::Scalar %}
                {{ stat.name }}: scalar_std_dev(
                    &stats_list.iter().map(|s| s.{{ section.name }}.{{ stat.name }}).collect::<Vec<_>>(),
                    mean.{{ section.name }}.{{ stat.name }},
                ),
                {%- when dsl::Ty::Map(_) %}
                {{ stat.name }}: map_std_dev(
                    &stats_list.iter().map(|s| &s.{{ section.name }}.{{ stat.name }}).collect::<Vec<_>>(),
                    &mean.{{ section.name }}.{{ stat.name }},
                ),
                {%- endmatch %}
                {%- endfor %}
            },
            {%- endfor %}
        };

        (mean, std_dev)
    }
}

impl Targets {
    pub fn from_mean_and_std_dev(mean: &Stats, std_dev: &Stats) -> Targets {
        Targets {
            {%- for target in targets %}
            {%- match target.ty %}
            {%- when dsl::Ty::Scalar %}
            {{ target.name }}: SingleTarget {
                value: mean.{{ target.source }},
                weight: 1.0,
                scale: std_dev.{{ target.source }}.max(1e-6),
            },
            {%- when dsl::Ty::Map(_) %}
            {{ target.name }}: MapTarget {
                value: mean.{{ target.source }}.clone(),
                weight: mean
                    .{{ target.source }}
                    .iter()
                    .map(|(k, _)| (k.clone(), 1.0))
                    .collect(),
                scale: std_dev
                    .{{ target.source }}
                    .iter()
                    .map(|(k, v)| (k.clone(), v.max(1e-6)))
                    .collect(),
            },
            {%- endmatch %}
            {%- endfor %}
        }
    }

    pub fn print(&self, digits: usize) -> String {
        let mut out = String::new();
        writeln!(&mut out, "optimization:").unwrap();
        writeln!(&mut out, "  targets:").unwrap();

        {%- for target in targets %}
        {%- if !loop.first %}
        writeln!(&mut out).unwrap();
        {%- endif %}
        writeln!(&mut out, "    {{ target.name }}:").unwrap();
        {%- match target.ty %}
        {%- when dsl::Ty::Scalar %}
        writeln!(
            &mut out,
            "      value: {v:.p$}",
            v = round(self.{{ target.name }}.value, digits),
            p = digits
        )
        .unwrap();
        writeln!(
            &mut out,
            "      weight: {v:.1}",
            v = round(self.{{ target.name }}.weight, 1)
        )
        .unwrap();
        writeln!(
            &mut out,
            "      scale: {v:.p$}",
            v = round_scale(self.{{ target.name }}.scale, digits),
            p = digits
        )
        .unwrap();
        {%- when dsl::Ty::Map(_) %}
        for (label, map) in [
            ("value", &self.{{ target.name }}.value),
            ("weight", &self.{{ target.name }}.weight),
            ("scale", &self.{{ target.name }}.scale),
        ] {
            if map.is_empty() {
                writeln!(&mut out, "      {label}: {}", "{}").unwrap();
                continue;
            }

            writeln!(&mut out, "      {label}:").unwrap();
            let mut entries: Vec<_> = map.iter().collect();
            entries.sort_by(|a, b| a.0.partial_cmp(b.0).unwrap());
            for (k, v) in entries {
                writeln!(
                    &mut out,
                    "        {k}: {v:.p$}",
                    k = k,
                    v = if label == "weight" {
                        round(*v, 1)
                    } else if label == "scale" {
                        round_scale(*v, digits)
                    } else {
                        round(*v, digits)
                    },
                    p = if label == "weight" { 1 } else { digits }
                )
                .unwrap();
            }
        }
        {%- endmatch %}
        {%- endfor %}

        out
    }
}
